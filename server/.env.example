# =======================================================
# CONFIGURATION SERVEUR - MS BAH PARFUM (BOUTIQUE MANAGER)
# =======================================================

# Port du serveur API (défaut : 5050)
PORT=5050
NODE_ENV=production

# Clé secrète pour la signature des jetons JWT
JWT_SECRET=ms_bah_parfum_super_secret_jwt_key_2026

# Connexion Neon PostgreSQL (Optionnelle pour le mode local SQLite)
# Remplacer par votre chaîne de connexion Neon :
# Format : postgresql://<user>:<password>@<endpoint-id>.c-2.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# Chemin de la base SQLite locale (utilisée en fallback ou pour le desktop hors-ligne)
DB_PATH=data/boutique.db
